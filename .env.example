# ---------- Logins (PRD_V3 §2) ----------
# One default password per portal for the prototype. Unset → Bank@2026 / Customer@2026, shown on the login screens.
# Set both to hide them from the login screens.
BANK_DEFAULT_PASSWORD=
CUSTOMER_DEFAULT_PASSWORD=
# Signs the session cookies. Set a long random string in production.
PORTAL_SESSION_SECRET=

# ---------- Database + files (free): Supabase Postgres + Storage ----------
# Run supabase/schema.sql once in the SQL editor, then paste the Project URL and the SECRET key
# (Project Settings → API Keys → sb_secret_…). Server-side only — never the publishable key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: storage bucket name (default pramaan-files, created by schema.sql)
SUPABASE_BUCKET=
# Alternative store if Supabase is not set: Upstash Redis / Vercel KV REST. Neither set → in-memory (local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Live market evidence around the property pin ----------
# Tavily real-time search + Google Gemini, which only COPIES printed figures (no AI arithmetic).
# Without Gemini a deterministic regex parser is used. Without Tavily, comparables are added manually.
TAVILY_API_KEY=
GEMINI_API_KEY=
# Optional: pin a model (default chain: gemini-4-hydrogen → gemini-flash-latest → gemini-flash-lite-latest).
GEMINI_MODEL=

# ---------- Maps ----------
# Google Maps JavaScript API key (restrict by HTTP referrer). Without it maps fall back to Esri / OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------- Video inspection call ----------
# TURN relay lets the call connect when both sides are behind strict / mobile-carrier NAT (recommended for real phones).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
