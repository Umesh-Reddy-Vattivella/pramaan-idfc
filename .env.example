# Live market evidence (/api/market-evidence) — primary, free: Tavily web search + free OpenRouter model.
TAVILY_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenRouter model override (default: nvidia/nemotron-3-ultra-550b-a55b:free, then other free models)
OPENROUTER_MODEL=

# Optional — Gemini: AI document upload (/api/analyze-live) and secondary live-search fallback.
# Without a key both run in offline / manual fallback modes. Search grounding may require billing on the Google Cloud project.
GEMINI_API_KEY=
# Optional model override (default chain: gemini-3.8-flash -> gemini-3.5-flash -> gemini-flash-latest -> gemini-3.5-flash-lite)
GEMINI_MODEL=
# Optional — Google Maps JavaScript API key (restrict by HTTP referrer). Without it, maps fall back to Esri / OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Customer valuation links (phone ↔ bank laptop). Optional locally (in-memory store),
# REQUIRED on Vercel for the live demo: add the free "Upstash for Redis" integration from the
# Vercel Marketplace — it injects these two automatically. UPSTASH_REDIS_REST_URL / _TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
